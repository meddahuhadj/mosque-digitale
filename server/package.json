{
  "name": "mosque-digital-os",
  "version": "1.0.0",
  "description": "Smart Digital Platform for Mosques — Backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^3.0.2",
    "adhan": "^4.4.6",
    "qrcode": "^1.5.4",
    "dotenv": "^16.4.7",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.7.5",
    "morgan": "^1.10.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1",
    "uuid": "^11.0.3",
    "node-cron": "^3.0.3",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/node-cron": "^3.0.11",
    "vitest": "^2.1.8",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0"
  }
}
