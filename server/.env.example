# ── Server ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://mosque:mosque_secret@localhost:5432/mosque_digital_os

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ── AI: Translation Providers (tried in order) ─────────
TRANSLATE_PROVIDERS=gemini,groq,openrouter,azure

GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# ── STT Providers (tried in order) ─────────────────────
STT_PROVIDERS=groq,gemini

# ── Limits ──────────────────────────────────────────────
MAX_HISTORY=40
MAX_LISTENERS=1500
MAX_AUDIO_BYTES=2000000
MAX_ROOMS=300
SEG_QUEUE_MAX=24
IDLE_ROOM_TTL=1200
RATE_LIMIT_SESSIONS_PER_IP=12

# ── Default Languages ───────────────────────────────────
DEFAULT_TARGET_LANGS=

# ── Frontend ────────────────────────────────────────────
FRONTEND_DIR=../frontend
